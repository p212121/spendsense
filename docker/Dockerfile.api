# ==========================================
# SpendSense 360 Production Dockerfile
# Optimized for Cloud Deployment (Render / AWS / GCP)
# ==========================================

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Install dependencies
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and pre-trained ML artifacts
COPY api /app/api
COPY ml /app/ml

# Render dynamically assigns $PORT (defaults to 8000 if not set)
EXPOSE 8000 10000

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
